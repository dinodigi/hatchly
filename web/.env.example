# Delivery-scoped Pluggie token (NOT the MCP token). Mint in Pluggie admin -> Settings -> Tokens.
AGENTX_DELIVERY_TOKEN=

# Clerk (instance glad-phoenix-18, already connected to Pluggie).
# Get both from https://dashboard.clerk.com -> API keys. App runs public-only without them.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# MCP-scoped Pluggie token (same as .mcp.json) — server-side economy writes only.
AGENTX_MCP_TOKEN=

# 32+ char random secret encrypting BYOK model keys at rest (AES-256-GCM).
HATCHLY_KEY_SECRET=
