next-env.d.ts

# Environment / secrets — NEVER commit these.
# web/.env.local holds the Pluggie delivery + MCP tokens, the Clerk secret key,
# and HATCHLY_KEY_SECRET (the AES key that decrypts users' own Anthropic keys).
# .env.example is the committed template and is deliberately allowed below.
.env
.env.*
!.env.example
*.pem
*.key

# Claude Code MCP config — holds a live Pluggie project token with full write
# access to the backend (wallets, ledger, schema). Copy .mcp.json.example and
# paste your own token; never commit the real one.
.mcp.json

